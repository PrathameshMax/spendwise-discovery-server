<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Polyrepo — the parent is a released artifact from GitHub Packages
         (spendwise-shared), not a sibling folder. The empty relativePath stops
         Maven from looking for ../pom.xml first. -->
    <parent>
        <groupId>com.spendwise</groupId>
        <artifactId>spendwise-parent</artifactId>
        <version>1.2.3</version>
        <relativePath/>
    </parent>

    <artifactId>discovery-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>SpendWise :: Discovery Server</name>
    <description>Milestone 10 — Eureka service registry every other module self-registers with,
        replacing the Milestone 9 hardcoded/env-parameterized host list as the source of truth for
        where a service instance actually lives</description>

    <scm>
        <url>https://github.com/PrathameshMax/spendwise-discovery-server</url>
        <connection>scm:git:https://github.com/PrathameshMax/spendwise-discovery-server.git</connection>
    </scm>

    <!-- Where spendwise-parent, spendwise-common and spendwise-events are
         published. Declared here because Maven has to find the parent before it
         can read the repositories the parent declares (Confluent's, for the
         Avro serializer). The id "github" matches the <server> holding the token. -->
    <repositories>
        <repository>
            <id>github</id>
            <name>SpendWise shared libraries</name>
            <url>https://maven.pkg.github.com/PrathameshMax/spendwise-shared</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.spendwise</groupId>
            <artifactId>spendwise-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
